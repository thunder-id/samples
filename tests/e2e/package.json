{
  "name": "@thunderid/samples-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "End-to-end tests for the ThunderID sample apps, one suite per app",
  "type": "module",
  "workspaces": [
    "shared",
    "*/*-e2e"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@thunderid/prettier-config": "latest",
    "@types/node": "24.7.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
