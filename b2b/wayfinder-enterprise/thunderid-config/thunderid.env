# Client secrets of the two applications. The sample ships without them: generate a value for each,
# for example with `openssl rand -base64 32`, and set the same values in the app's .env.local as
# THUNDERID_CLIENT_SECRET and WAYFINDER_BACKEND_CLIENT_SECRET.
WAYFINDER_ENTERPRISE_CLIENT_ID=WAYFINDER_ENTERPRISE
WAYFINDER_ENTERPRISE_CLIENT_SECRET=
WAYFINDER_ENTERPRISE_REDIRECT_URIS=["http://localhost:3000"]
WAYFINDER_ENTERPRISE_POST_LOGOUT_REDIRECT_URIS=["http://localhost:3000"]
WAYFINDER_ENTERPRISE_BACKEND_CLIENT_ID=WAYFINDER_ENTERPRISE_BACKEND
WAYFINDER_ENTERPRISE_BACKEND_CLIENT_SECRET=
