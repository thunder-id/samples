# Base URL of your ThunderID deployment. ex: https://localhost:8090
VITE_THUNDERID_BASE_URL=https://localhost:8090

# OAuth2 Client ID for this app. ThunderID Console -> your application -> Overview.
VITE_THUNDERID_CLIENT_ID=your-client-id-here

# The handle of the flow that creates an agent. A standard install already has this one.
VITE_AGENT_ONBOARDING_FLOW_HANDLE=default-agent-onboarding-flow

# The part of ThunderID that guards admin information. A standard install already uses this default.
VITE_THUNDERID_RESOURCE=https://localhost:8090/mcp
