  },
  "dependencies": {
    "@thunderid/react": "1.4.0",
    "@thunderid/react-router": "1.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@thunderid/eslint-plugin": "1.0.1",
    "@thunderid/prettier-config": "1.0.1",
    "@types/node": "24.7.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.0.16"
