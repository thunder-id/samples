# Base URL of your ThunderID server.
VITE_THUNDERID_BASE_URL=https://localhost:8090

# Client ID of the application the import creates. Matches REACT_B2B_CLIENT_ID in thunderid-config/thunderid.env.
VITE_THUNDERID_CLIENT_ID=REACT_B2B_QUICKSTART

# Identifier of the System resource server, whose org permission a company admin's token carries.
VITE_THUNDERID_RESOURCE=https://localhost:8090/mcp

# ID of the sign-in flow the import creates. A company admin sets the flow's enterpriseIdp variable for their company.
VITE_THUNDERID_SIGN_IN_FLOW_ID=019f0b10-0000-7000-8000-000000000021
