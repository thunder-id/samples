# Base URL of your ThunderID server.
NEXT_PUBLIC_THUNDERID_BASE_URL=https://localhost:8090

# Credentials of the application the import creates. Set THUNDERID_CLIENT_SECRET to the client secret
# you set as NEXTJS_B2B_CLIENT_SECRET when you imported thunderid-config/thunderid.env.
NEXT_PUBLIC_THUNDERID_CLIENT_ID=NEXTJS_B2B_QUICKSTART
THUNDERID_CLIENT_SECRET=

# Where ThunderID returns the browser after sign-in.
NEXT_PUBLIC_THUNDERID_AFTER_SIGN_IN_URL=http://localhost:3000

# Where ThunderID returns the browser after sign-out.
NEXT_PUBLIC_THUNDERID_AFTER_SIGN_OUT_URL=http://localhost:3000

# `ou` and `roles` put the company and the user's roles there into the tokens. `org` asks for the
# permission a company admin needs to manage their company, such as its identity provider.
# `device_sso` asks for a device secret, which lets the server switch companies without a redirect.
NEXT_PUBLIC_THUNDERID_SCOPES=openid profile email roles ou org device_sso

# ID of the sign-in flow the import creates. A company admin sets the flow's enterpriseIdp variable for their company.
NEXT_PUBLIC_THUNDERID_SIGN_IN_FLOW_ID=019f0b20-0000-7000-8000-000000000021

# Signs the session cookie. Generate it with `openssl rand -base64 32`.
THUNDERID_SECRET=

# DANGER: Disables ALL TLS verification. Only for local development with self-signed certs. NEVER use in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
