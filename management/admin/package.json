{
  "name": "@thunderid/admin",
  "private": true,
  "version": "1.0.0",
  "description": "ThunderID Admin app, where an administrator manages users, groups, roles, applications, agents, flows, projects and organization units.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs",
    "lint:fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx,.cjs,.mjs",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache ."
  },
  "dependencies": {
    "@thunderid/react": "1.15.0",
    "@thunderid/react-router": "1.12.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@thunderid/eslint-plugin": "1.0.1",
    "@thunderid/prettier-config": "1.0.1",
    "@types/node": "24.7.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "core-js": false
  }
}
